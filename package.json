{
  "name": "lettermint",
  "version": "3.0.0",
  "description": "Official Lettermint SDK for Node.js, Bun, Deno and edge runtimes",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "UPGRADE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:smoke": "node scripts/smoke.mjs",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lettermint/lettermint-node.git"
  },
  "keywords": [
    "lettermint",
    "email",
    "transactional email",
    "sdk",
    "webhooks"
  ],
  "author": "Bjarn Bronsveld",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lettermint/lettermint-node/issues"
  },
  "homepage": "https://github.com/lettermint/lettermint-node#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
